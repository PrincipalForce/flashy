node_modules/
.DS_Store
Thumbs.db
*.log

# Local Claude Code state, but NOT the project skills — those document how to
# run and verify the app and are worth sharing with contributors.
.claude/*
!.claude/skills/
.claude/settings.local.json

# Electron packaging output
release/

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Scratch documents saved while testing the editor. Anchored to the repo root
# on purpose: the demos in examples/ are real fixtures and must stay
# committable, so never loosen this to a bare *.flashy.
/*.flashy

# Local product/planning metadata written by editor tooling, not project state.
.product.yml

# Flash movies kept locally to test the importer against real content. They
# are somebody else's work — the specs build their own fixtures in
# tests/flash-fixtures.js precisely so nothing copyrighted has to be
# committed to run them.
/swf/
